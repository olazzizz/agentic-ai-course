# Copy to labenv.env and adjust. Everything is optional; defaults are shown.
# DO NOT put API keys in this file. Use LAB_SECRETS_FILE (below) or export them in your shell.

# --- general ---
LAB_PREFIX=agentic-lab                 # project name = <prefix>-<lab>, e.g. agentic-lab-lab01
# LAB_NAMESPACE=                       # reuse ONE existing project (Developer Sandbox / restricted clusters).
                                       # Disables project creation; 'down' then deletes only our resources.
LAB_ASSUME_YES=0                       # 1 = don't ask "run on THIS cluster?"
# LAB_COST_PER_HOUR=1.50               # USD/h of your cluster (from the provider), for `status` estimates
LAB_OPENSHIFT_AI=auto                  # auto | 1 | 0  (1 marks the project as a Data Science Project)

# --- secrets: a KEY=VALUE file OUTSIDE git, chmod 600 ---
# It may contain OPENROUTER_API_KEY=...   OR the same HOSTED_* lines as Lab 1's .env when HOSTED_BASE_URL is OpenRouter.
# LAB_SECRETS_FILE=$HOME/.config/labenv/secrets.env

# --- inference backend A: OpenRouter (no GPU, nothing to host) ---
LAB_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# LAB_OPENROUTER_MODEL=                # pick one: bash labenv.sh models --tools --structured --limit 15
                                       # (agents need tool calling; Chapter 3 onward)

# --- inference backend B: Ollama on CPU inside the cluster ---
LAB_OLLAMA_MODEL=qwen3:4b              # 8B needs ~10 GiB RAM: LAB_OLLAMA_MODEL=qwen3:8b, MEM_REQ=10Gi, MEM_LIM=14Gi
LAB_OLLAMA_IMAGE=docker.io/ollama/ollama:latest   # pin a tag for reproducibility; Docker Hub may rate-limit pulls
LAB_OLLAMA_CPU_REQ=2
LAB_OLLAMA_CPU_LIM=4
LAB_OLLAMA_MEM_REQ=6Gi
LAB_OLLAMA_MEM_LIM=10Gi
LAB_OLLAMA_PVC_SIZE=20Gi

# --- namespace guard rails (need cluster-admin; skipped with a warning otherwise) ---
LAB_QUOTA_CPU_REQ=8
LAB_QUOTA_MEM_REQ=24Gi
LAB_QUOTA_CPU_LIM=16
LAB_QUOTA_MEM_LIM=32Gi
LAB_QUOTA_PODS=30
LAB_QUOTA_STORAGE=50Gi

# --- in-cluster connectivity test image (needs curl) ---
LAB_TEST_IMAGE=registry.access.redhat.com/ubi9/ubi:latest
