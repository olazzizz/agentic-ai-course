# Same variable names as Labs 1 and 2: copy your ../../chapter-02/lab02/.env here.
# Never commit .env (the .gitignore covers it).

# ---- HOSTED model (recommended: this lab needs reliable tool calling, and runs 100+ calls) ----
# OpenRouter: bash ../../lab-env/labenv.sh models --tools --structured --limit 15
#             bash ../../lab-env/labenv.sh price <model-id>
HOSTED_BASE_URL=https://openrouter.ai/api/v1
HOSTED_API_KEY=
HOSTED_MODEL=
HOSTED_PRICE_IN=0
HOSTED_PRICE_OUT=0

# ---- LOCAL model (Ollama). Only worth it for one comparison run; small CPU models are slow at tool calls ----
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama
LOCAL_MODEL=qwen3:8b
LOCAL_PRICE_IN=0
LOCAL_PRICE_OUT=0

# Sampling temperature. Set to empty (TEMPERATURE=) if the model rejects it.
TEMPERATURE=0

# ---- Agent guards (higher than Lab 2: tasks need more steps and the tool list is longer) ----
MAX_STEPS=10
MAX_TOTAL_TOKENS=60000
MAX_OUTPUT_TOKENS=4000
MAX_SECONDS=120

# ---- Experiment guard: experiment.py stops when the summed cost passes this (USD). Needs the prices above. ----
MAX_EXPERIMENT_COST=1.00

# ---- Tools ----
# Extra hosts http_get / fetch_page may reach, comma separated (host:port). Empty = only the local lab server.
ALLOWED_HOSTS=
# FIXTURE_PORT=8765
