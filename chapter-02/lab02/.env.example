# Same variable names as Lab 1: you can copy your lab01/.env here and add the last block.

# ---- LOCAL model (Ollama). Needs a tool-calling model; small CPU models are slow AND unreliable at it. ----
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama
LOCAL_MODEL=qwen3:8b

# ---- HOSTED model (recommended for this lab: it needs reliable tool calling) ----
# OpenRouter: bash ../lab-env/labenv.sh models --tools --structured --limit 15
#             bash ../lab-env/labenv.sh price <model-id>
HOSTED_BASE_URL=https://openrouter.ai/api/v1
HOSTED_API_KEY=
HOSTED_MODEL=
HOSTED_PRICE_IN=0
HOSTED_PRICE_OUT=0

# Sampling temperature. Set to empty (TEMPERATURE=) if the model rejects it.
TEMPERATURE=0

# ---- Agent guards ----
MAX_STEPS=8
MAX_TOTAL_TOKENS=30000
