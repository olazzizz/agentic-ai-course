# ---- LOCAL model (Ollama on your laptop, free) ----
# Cluster variant: run `bash lab-env/labenv.sh forward lab01` and keep these values (or use port 11435).
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama
LOCAL_MODEL=qwen3:8b
# Pause (seconds) after each call to this profile, e.g. to let a laptop CPU cool between
# requests and avoid thermal throttling on sustained runs. 0 = no delay. Not needed for
# HOSTED (remote API, no local heat) - only set LOCAL_DELAY_S, leave HOSTED_DELAY_S unset.
LOCAL_DELAY_S=10

# ---- HOSTED model: OpenRouter is the recommended cheap option ----
# 1. Create a key at openrouter.ai and set a small credit limit on it (a few dollars) in the dashboard.
# 2. Find a cheap tool-capable model and its prices:
#      bash lab-env/labenv.sh models --tools --structured --limit 15
#      bash lab-env/labenv.sh price <model-id>      # prints the 3 lines below
HOSTED_BASE_URL=https://openrouter.ai/api/v1
HOSTED_API_KEY=
HOSTED_MODEL=
# USD per 1M tokens (from `labenv.sh price`; 0 for :free models)
HOSTED_PRICE_IN=0
HOSTED_PRICE_OUT=0

# Other OpenAI-compatible providers also work (leave HOSTED_BASE_URL empty to skip):
#   Google AI Studio: https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq:             https://api.groq.com/openai/v1
#   GitHub Models:    https://models.github.ai/inference

# Sampling temperature. Set to empty (TEMPERATURE=) if the model rejects it.
TEMPERATURE=0
